# YOLO Configuration
YOLO_MODEL_PATH=weights/yolov8n.pt
CONFIDENCE_THRESHOLD=0.4

# Tracking (comma separated COCO class names)
VEHICLE_CLASSES=car,motorcycle,bus,truck

# Speed Detection (line values <= 1 are fractions of the frame height)
SPEED_LIMIT_KMH=60
LINE_1_Y=0.55
LINE_2_Y=0.80
REAL_DISTANCE_METERS=10

# OCR Configuration
OCR_LANGUAGES=en
OCR_FRAME_INTERVAL=10
OCR_MIN_CONFIDENCE=0.25
OCR_USE_GPU=false

# Video Upload
UPLOAD_DIR=data/videos
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///data/traffic.db

# Output
OUTPUT_DIR=data/outputs

# Logging
LOG_LEVEL=INFO

# Dashboard (built React app served at http://localhost:8000)
FRONTEND_DIST_DIR=frontend/dist

# Performance (CPU friendly defaults)
YOLO_IMAGE_SIZE=640
TARGET_PROCESS_FPS=10
TORCH_THREADS=0
PRELOAD_MODELS=true
OUTPUT_MAX_WIDTH=1280
PREVIEW_INTERVAL_SECONDS=1.0

# OCR speed controls
OCR_MODE=all
OCR_MAX_PER_FRAME=1
OCR_MAX_ATTEMPTS_PER_TRACK=6
OCR_MIN_BOX_HEIGHT=60
OCR_MAX_CROP_WIDTH=360

# Helmet check (motorcycle riders). Needs a YOLO helmet model file.
HELMET_DETECTION_ENABLED=true
HELMET_MODEL_PATH=weights/helmet.onnx
HELMET_CONFIDENCE=0.35
HELMET_CLASS_NAMES=helmet,with helmet,with_helmet,withhelmet
NO_HELMET_CLASS_NAMES=no helmet,no-helmet,no_helmet,without helmet,without_helmet,nohelmet,head
HELMET_RIDER_CLASSES=motorcycle
HELMET_VOTES_REQUIRED=3
HELMET_MAX_PER_FRAME=4
