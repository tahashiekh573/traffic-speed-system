# YOLO Configuration
YOLO_MODEL_PATH=weights/yolov8n.pt
CONFIDENCE_THRESHOLD=0.4

# Speed Detection
SPEED_LIMIT_KMH=60
LINE_1_Y=300
LINE_2_Y=500
REAL_DISTANCE_METERS=10

# OCR Configuration
OCR_LANGUAGES=en

# Database
DATABASE_URL=sqlite:///data/traffic.db

# Output
OUTPUT_DIR=data/outputs

# Logging
LOG_LEVEL=INFO
